# ========================================================
# Smart Assignment Recommender (RAG System) - Backend Config
# ========================================================

# Host & Port
HOST=0.0.0.0
PORT=8000

# Embedding Provider: "local" (default zero-dep offline), "openai", or "gemini"
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=128

# LLM Provider: "pedagogical_engine" (default built-in), "openai", or "gemini"
LLM_PROVIDER=pedagogical_engine

# Optional Cloud API Keys (Leave blank to use built-in zero-cost local engines)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Firebase Configuration
# Set USE_FIREBASE_MOCK=false and provide path to serviceAccountKey.json for production Firestore
USE_FIREBASE_MOCK=true
FIREBASE_PROJECT_ID=smart-assignment-rag-demo
FIREBASE_CREDENTIALS_PATH=
